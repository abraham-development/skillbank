{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Banco de Skills",
  "mainBinaryName": "banco-de-skills",
  "version": "0.1.0",
  "identifier": "dev.bancodeskills.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Banco de Skills",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "category": "DeveloperTool",
    "shortDescription": "Tu banco personal de Agent Skills",
    "longDescription": "Guarda tus Agent Skills en un banco personal y reutilízalas entre proyectos con Claude Code, Cursor y Antigravity.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"]
  }
}
